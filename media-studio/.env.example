# Copy to your local environment. Never commit real secrets.
HOST=127.0.0.1
PORT=8787
OWNER_ACCESS_TOKEN=
# Generate a password hash locally; the plaintext password is never stored.
# OWNER_PASSWORD_HASH=scrypt$<salt-hex>$<hash-hex>
DATA_FILE=./data/jobs.json

# Optional text/script engine (OpenAI-compatible Chat Completions API).
# This remains OFF until both values are configured on the server.
# Provider usage may incur charges. Check provider pricing and set account limits first.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional human-like AI presenter with natural voice and lip sync (HeyGen).
# Set both values only after reviewing provider pricing and creating an API key.
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# Optional: pair an avatar with a specific compatible voice.
# HEYGEN_VOICE_ID=
