# Copy to your local environment. Never commit real secrets.
HOST=127.0.0.1
PORT=8787
OWNER_ACCESS_TOKEN=
# Generate a password hash locally; the plaintext password is never stored.
# OWNER_PASSWORD_HASH=scrypt$<salt-hex>$<hash-hex>
DATA_FILE=./data/jobs.json

# Live country research and optional text/script engine.\n# Live research uses OpenAI Responses API web search on every new country video package.\n# This is not enabled until credentials are configured. Provider usage may incur charges.\n# OPENAI_API_KEY=\n# OPENAI_MODEL=\n\n# Optional text/script engine (OpenAI-compatible Chat Completions API).
# This remains OFF until both values are configured on the server.
# Provider usage may incur charges. Check provider pricing and set account limits first.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional human-like AI presenter with natural voice and lip sync (HeyGen).
# Set both values only after reviewing provider pricing and creating an API key.
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# Optional: pair an avatar with a specific compatible voice.
# HEYGEN_VOICE_ID=

# Meta Facebook Login + country-specific Page connections.
# Keep secrets server-side only. META_TOKEN_STORE_FILE must point to a durable private volume.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://media-studio-production-33a2.up.railway.app/auth/meta/callback
# Generate 32 random bytes and encode as 64 hexadecimal characters for AES-256-GCM.
# META_TOKEN_ENCRYPTION_KEY=
# META_TOKEN_STORE_FILE=/data/private/meta-connections.enc
# META_GRAPH_API_VERSION=v26.0
# Set true ONLY after Meta confirms the app is allowlisted for Page creation.
# META_PAGE_CREATION_ENABLED=false
