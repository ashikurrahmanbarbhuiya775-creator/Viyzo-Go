# Copy to .env on the deployment host. Never commit the real .env file.
# Generate a strong owner password hash with:
#   printf '%s' 'YOUR_LONG_PRIVATE_PASSWORD' | docker compose run --rm --no-deps -T media-studio node scripts/hash-owner-password.mjs
# Put the resulting scrypt$... value below. Do not store the plaintext password.
OWNER_PASSWORD_HASH=scrypt$REPLACE_WITH_GENERATED_SALT_AND_HASH
OWNER_ACCESS_TOKEN=

# AI script + metadata engine (OFF until all three values are set; provider usage may be billed).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Human-like AI presenter (OFF until both values are set; provider usage may be billed).
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
